{
  "name": "git-simple-alert",
  "displayName": "Git Simple Alert",
  "description": "A simple visible status bar alert for Git changes that are easy to miss.",
  "version": "0.2.0",
  "publisher": "t4n4k4-kun",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitSimpleAlert.watchRemoteNow",
        "title": "Git Simple Alert: Watch Remote Now"
      },
      {
        "command": "gitSimpleAlert.openScm",
        "title": "Git Simple Alert: Open Source Control"
      },
      {
        "command": "gitSimpleAlert.openSettings",
        "title": "Git Simple Alert: Open Settings"
      }
    ],
    "configuration": {
      "title": "Git Simple Alert",
      "properties": {
        "gitSimpleAlert.pollingSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "description": "Polling interval in seconds for checking git status.",
          "markdownDescription": "Polling interval in seconds for checking local git status. Min: 10, recommended: 30+."
        },
        "gitSimpleAlert.fetchIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Interval in seconds for fetching remote refs.",
          "markdownDescription": "Interval in seconds for running `git fetch --no-tags --quiet`. Min: 15, recommended: 60+."
        },
        "gitSimpleAlert.watchDurationSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "Duration in seconds for Watch Remote Now mode."
        },
        "gitSimpleAlert.watchFetchIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "Fetch interval in seconds while Watch Remote Now mode is active."
        },
        "gitSimpleAlert.watchCooldownSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "Initial cooldown in seconds for Watch Remote Now."
        },
        "gitSimpleAlert.includeUntracked": {
          "type": "boolean",
          "default": false,
          "description": "Include untracked files in the dirty count."
        },
        "gitSimpleAlert.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging to the Output panel."
        },
        "gitSimpleAlert.applyColorCustomizations": {
          "type": "boolean",
          "default": true,
          "description": "Auto-apply workbench color customizations for tier colors when missing."
        },
        "gitSimpleAlert.tiers": {
          "type": "object",
          "default": {
            "tier1": {
              "types": [
                "ahead",
                "uncommitted"
              ],
              "backgroundColor": "statusBarItem.errorBackground",
              "foregroundColor": "statusBarItem.errorForeground"
            },
            "tier2": {
              "types": [
                "behind"
              ],
              "backgroundColor": "statusBarItem.warningBackground",
              "foregroundColor": "statusBarItem.warningForeground"
            },
            "tier3": {
              "types": [],
              "backgroundColor": "statusBarItem.warningBackground",
              "foregroundColor": "statusBarItem.warningForeground"
            }
          },
          "description": "Alert tiers. Each tier defines which alert types trigger it and the colors to use.",
          "properties": {
            "tier1": {
              "type": "object",
              "description": "Highest priority tier.",
              "properties": {
                "types": {
                  "type": "array",
                  "default": [
                    "ahead",
                    "uncommitted"
                  ],
                  "items": {
                    "type": "string",
                    "enum": [
                      "ahead",
                      "behind",
                      "uncommitted"
                    ]
                  },
                  "description": "Alert types that trigger Tier 1."
                },
                "backgroundColor": {
                  "type": "string",
                  "default": "statusBarItem.errorBackground",
                  "description": "Theme color id for Tier 1 background."
                },
                "foregroundColor": {
                  "type": "string",
                  "default": "statusBarItem.errorForeground",
                  "description": "Theme color id for Tier 1 foreground."
                }
              }
            },
            "tier2": {
              "type": "object",
              "description": "Middle priority tier.",
              "properties": {
                "types": {
                  "type": "array",
                  "default": [
                    "behind"
                  ],
                  "items": {
                    "type": "string",
                    "enum": [
                      "ahead",
                      "behind",
                      "uncommitted"
                    ]
                  },
                  "description": "Alert types that trigger Tier 2."
                },
                "backgroundColor": {
                  "type": "string",
                  "default": "statusBarItem.warningBackground",
                  "description": "Theme color id for Tier 2 background."
                },
                "foregroundColor": {
                  "type": "string",
                  "default": "statusBarItem.warningForeground",
                  "description": "Theme color id for Tier 2 foreground."
                }
              }
            },
            "tier3": {
              "type": "object",
              "description": "Lowest priority tier.",
              "properties": {
                "types": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string",
                    "enum": [
                      "ahead",
                      "behind",
                      "uncommitted"
                    ]
                  },
                  "description": "Alert types that trigger Tier 3."
                },
                "backgroundColor": {
                  "type": "string",
                  "default": "statusBarItem.warningBackground",
                  "description": "Theme color id for Tier 3 background."
                },
                "foregroundColor": {
                  "type": "string",
                  "default": "statusBarItem.warningForeground",
                  "description": "Theme color id for Tier 3 foreground."
                }
              }
            }
          }
        }
      }
    }
  }
}
